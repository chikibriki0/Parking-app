# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не должен попадать в git (см. .gitignore).

# === Обязательные ===
# JWT-секрет для подписи токенов. Сгенерируйте, например, командой:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-bytes

# === PostgreSQL ===
POSTGRES_DB=parking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433

# DSN, который видит сервис изнутри docker-сети.
# Если хост/порт/пользователь меняете выше, отразите это и здесь.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/parking_db?sslmode=disable

# === HTTP backend ===
BACKEND_HOST_PORT=8080
HTTP_ADDR=:8080

# Время жизни JWT (формат time.Duration: 24h, 30m, 168h и т.д.)
JWT_TTL=24h

# Через сколько активная парковка автоматически завершается (демо: 2m, прод: например 4h)
PARKING_EXPIRE_AFTER=2m

# Включить эмулятор парковочного трафика. Для прода: false.
SIMULATION_ENABLED=false

# Разрешённые источники для CORS. "*" — все. В проде укажите конкретный домен:
# CORS_ALLOWED_ORIGINS=https://parking.example.com,https://admin.parking.example.com
CORS_ALLOWED_ORIGINS=*
