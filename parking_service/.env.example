# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не должен попадать в git (см. .gitignore).

# === КРИТИЧНО: оба секрета должны быть случайными и длинными ===
# Сгенерируйте, например, командой:
#   openssl rand -base64 48

# JWT-секрет для подписи токенов
JWT_SECRET=replace-me-with-openssl-rand-base64-48

# Пароль PostgreSQL. ВНИМАНИЕ: PostgreSQL-superuser умеет COPY TO PROGRAM (RCE),
# то есть подбор пароля даёт атакующему shell на хосте контейнера.
# НЕ оставляйте "postgres" или другие стандартные значения.
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-32

# === Прочие настройки БД ===
POSTGRES_DB=parking_db
POSTGRES_USER=postgres

# DSN, по которому ходит backend. Пароль ДОЛЖЕН совпадать с POSTGRES_PASSWORD.
# Хост `postgres` — это имя контейнера в docker-сети, не localhost.
DATABASE_URL=postgres://postgres:replace-me-same-as-POSTGRES_PASSWORD@postgres:5432/parking_db?sslmode=disable

# === HTTP backend ===
BACKEND_HOST_PORT=8080
HTTP_ADDR=:8080
JWT_TTL=24h

# Через сколько активная парковка авто-завершается (демо: 2m, прод: 4h и т.п.)
PARKING_EXPIRE_AFTER=2m

# Эмулятор парковочного трафика. Для прода: false.
SIMULATION_ENABLED=false

# Разрешённые источники для CORS. "*" — все. В проде указывайте конкретный домен:
# CORS_ALLOWED_ORIGINS=https://parking.example.com
CORS_ALLOWED_ORIGINS=*
